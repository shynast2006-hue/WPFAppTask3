<Window x:Class="WPFApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Записи из CSV" Height="700" Width="1080"
        MinHeight="600" MinWidth="920"
        Loaded="Window_Loaded">
    <Grid x:Name="MainContentGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="Импорт данных" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="CSV-файл" Target="{Binding ElementName=CsvPathTextBox}" />
                <TextBox x:Name="CsvPathTextBox" Grid.Row="1" Height="30"
                         IsReadOnly="True" VerticalContentAlignment="Center" />
                <Button Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Padding="14,0"
                        Content="Выбрать..." Click="ChooseCsvButton_Click" />
                <Button Grid.Row="1" Grid.Column="2" Margin="10,0,0,0" Padding="14,0"
                        Content="Открыть" Click="ImportButton_Click" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Поиск" Padding="10" Margin="0,12,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="Дата с" Target="{Binding ElementName=FromDatePicker}" />
                <Label Grid.Column="1" Content="Дата по" Target="{Binding ElementName=ToDatePicker}" />
                <Label Grid.Column="2" Content="Имя" Target="{Binding ElementName=FirstNameTextBox}" />
                <Label Grid.Column="3" Content="Фамилия" Target="{Binding ElementName=LastNameTextBox}" />
                <Label Grid.Column="4" Content="Отчество" Target="{Binding ElementName=SurNameTextBox}" />
                <Label Grid.Column="5" Content="Город" Target="{Binding ElementName=CityTextBox}" />
                <Label Grid.Column="6" Content="Страна" Target="{Binding ElementName=CountryTextBox}" />

                <DatePicker x:Name="FromDatePicker" Grid.Row="1" Margin="0,2,8,0" VerticalContentAlignment="Center" />
                <DatePicker x:Name="ToDatePicker" Grid.Row="1" Grid.Column="1" Margin="0,2,8,0" VerticalContentAlignment="Center" />
                <TextBox x:Name="FirstNameTextBox" Grid.Row="1" Grid.Column="2" Margin="0,2,8,0" Height="28" VerticalContentAlignment="Center" />
                <TextBox x:Name="LastNameTextBox" Grid.Row="1" Grid.Column="3" Margin="0,2,8,0" Height="28" VerticalContentAlignment="Center" />
                <TextBox x:Name="SurNameTextBox" Grid.Row="1" Grid.Column="4" Margin="0,2,8,0" Height="28" VerticalContentAlignment="Center" />
                <TextBox x:Name="CityTextBox" Grid.Row="1" Grid.Column="5" Margin="0,2,8,0" Height="28" VerticalContentAlignment="Center" />
                <TextBox x:Name="CountryTextBox" Grid.Row="1" Grid.Column="6" Margin="0,2,0,0" Height="28" VerticalContentAlignment="Center" />
                <Button Grid.Row="1" Grid.Column="7" Margin="10,2,0,0" Padding="14,0"
                        Content="Найти" Click="SearchButton_Click" />
            </Grid>
        </GroupBox>

        <DataGrid x:Name="RecordsGrid" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="110" />
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*" />
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*" />
                <DataGridTextColumn Header="Отчество" Binding="{Binding SurName}" Width="*" />
                <DataGridTextColumn Header="Город" Binding="{Binding City}" Width="*" />
                <DataGridTextColumn Header="Страна" Binding="{Binding Country}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="PreviousPageButton" Padding="10,0" Height="30" Content="Назад" Click="PreviousPageButton_Click" />
                <TextBlock x:Name="PageTextBlock" Margin="10,0" VerticalAlignment="Center" />
                <Button x:Name="NextPageButton" Padding="10,0" Height="30" Content="Вперёд" Click="NextPageButton_Click" />
                <Button Padding="14,0" Height="30" Content="Экспорт в Excel" Click="ExportExcelButton_Click" />
                <Button Margin="10,0,0,0" Padding="14,0" Height="30" Content="Экспорт в XML" Click="ExportXmlButton_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Text="Загрузка данных..." />
        </DockPanel>
    </Grid>
</Window>
